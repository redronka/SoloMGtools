{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WN-Generators PL — dane generatorów",
  "description": "Tabele losowe, rekordy opisowe i jawne zależności procedur kompilacji 63 stron. Dodatkowa kontrola referencji i pokrycia kości: pipeline/validate_data.py.",
  "type": "object",
  "required": [
    "schema_version",
    "language",
    "source",
    "categories",
    "generators",
    "tables",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "language": {
      "const": "pl"
    },
    "source": {
      "type": "object"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "generators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/generator"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "external_resources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "statistics": {
      "type": "object"
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "pdf_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "pdf_page",
        "bbox"
      ],
      "additionalProperties": true
    },
    "column": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name_pl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name_pl"
      ],
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "roll": {
          "anyOf": [
            {
              "$ref": "#/$defs/range"
            },
            {
              "type": "null"
            }
          ]
        },
        "cells": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "first_roll": {
          "type": "integer",
          "minimum": 1
        },
        "second_roll": {
          "type": "integer",
          "minimum": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "id",
        "roll",
        "cells"
      ],
      "additionalProperties": true
    },
    "dice": {
      "type": "object",
      "properties": {
        "notation": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "enum": [
            "single",
            "sum",
            "nested",
            "none"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "method"
      ],
      "additionalProperties": true
    },
    "table": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "name_pl": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "dice": {
          "$ref": "#/$defs/dice"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "notes_pl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "generator_id",
        "name_pl",
        "source",
        "dice",
        "columns",
        "rows"
      ],
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "table_id": {
          "type": "string",
          "minLength": 1
        },
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "external_reference_id": {
          "type": "string",
          "minLength": 1
        },
        "selector_step_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "roll",
            "choose",
            "roll_or_choose",
            "generate",
            "resolve_actions"
          ]
        },
        "repeat": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "object"
            }
          ]
        },
        "optional": {
          "type": "boolean"
        },
        "condition": {},
        "notes_pl": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "mode"
      ],
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "sequence",
            "conditional",
            "lookup",
            "independent",
            "external_reference"
          ]
        },
        "from_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_table_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "condition": {},
        "notes_pl": {
          "type": "string"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "generator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category_id": {
          "type": "string",
          "minLength": 1
        },
        "name_pl": {
          "type": "string",
          "minLength": 1
        },
        "name_en": {
          "type": "string"
        },
        "source_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 63
          }
        },
        "instructions_pl": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "external_references": {
          "type": "array",
          "items": {}
        },
        "table_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "genre": {
          "enum": [
            "science_fiction",
            "cyberpunk",
            "post_apocalypse"
          ]
        }
      },
      "required": [
        "id",
        "category_id",
        "name_pl",
        "source_pages",
        "instructions_pl",
        "steps",
        "relationships"
      ],
      "additionalProperties": true
    },
    "category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name_pl": {
          "type": "string",
          "minLength": 1
        },
        "generator_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "name_pl",
        "generator_ids"
      ],
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name_pl": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "description_pl": {
          "type": "string"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 63
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
